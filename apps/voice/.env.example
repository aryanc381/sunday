PORT=4100

# LiveKit (the dev keys match docker-compose.yaml)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Sarvam: speech-to-text, the LLM and text-to-speech
SARVAM_API_KEY=
SARVAM_LLM_MODEL=sarvam-m
# A bulbul:v4-flash voice, e.g. shubh_enhi_ads or ritu_hi_customer
SARVAM_TTS_SPEAKER=shubh_enhi_ads

# Vobiz SIP trunk. The login is optional, but set both parts together.
VOBIZ_SIP_DOMAIN=
VOBIZ_CALLER_NUMBER=
VOBIZ_SIP_USERNAME=
VOBIZ_SIP_PASSWORD=

# MongoDB: the contacts and tasks collections
MONGODB_URI=mongodb://localhost:27017/sunday

# The one phone number allowed to call in, with the country code. The agent also calls it back with results.
ALLOWED_CALLER_NUMBER=
